<Window x:Class="VideoStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Video Studio" Width="1240" Height="850" MinWidth="1030" MinHeight="730" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
 <Window.Resources>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,4"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="Chip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="6"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource Backdrop}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
   <Grid Margin="18,29,18,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="12,0,0,38">
     <Image Source="/Assets/video-studio.png" Width="62" Height="62" HorizontalAlignment="Left" Margin="-5,-5,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock Text="video studio" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="BAĞLANTIYI YAKALA." FontSize="9" Foreground="{DynamicResource Muted}" Margin="1,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="NewNav" Style="{StaticResource Nav}" Tag="new" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,2,13,0"/><TextBlock Text="Yeni indirme"/></StackPanel></Button>
     <Button x:Name="HistoryNav" Style="{StaticResource Nav}" Tag="history" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,2,13,0"/><TextBlock Text="İndirilenler"/></StackPanel></Button>
     <Border Height="1" Background="{DynamicResource Line}" Opacity="0.4" Margin="14,18"/>
     <Button x:Name="ThemesNav" Style="{StaticResource Nav}" Tag="themes" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" Margin="0,2,13,0"/><TextBlock Text="Görünüm"/></StackPanel></Button>
     <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Tag="settings" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,2,13,0"/><TextBlock Text="Ayarlar"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="13,0,8,0">
     <TextBlock Text="KENDİ RİTMİNDE." FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
     <TextBlock Text="Videoların ve seslerin,&#10;tek bir yerde." Style="{StaticResource Hint}"/>
     <TextBlock Text="Video Studio  /  1.1.1" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,23,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,25,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,23">
    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="{DynamicResource Mint}" Margin="0,0,7,0"/><TextBlock x:Name="EngineStatus" Text="Motor hazır" FontSize="11"/></StackPanel></Border>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ÇALIŞMA ALANI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="PageCrumb" Text="  /  Yeni indirme" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,12">
    <Grid>
     <StackPanel x:Name="NewPage">
      <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="Bağlantıdan, arşivine." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Bir bağlantı yapıştır. Biçimini seç. Gerisini bize bırak." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,9,0,0"/></StackPanel></DockPanel>
      <Border Style="{StaticResource GlassCard}" Padding="22,19" Margin="0,0,0,18">
       <StackPanel>
        <DockPanel Margin="0,0,0,11"><TextBlock Text="VİDEO BAĞLANTISI" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock DockPanel.Dock="Right" Text="Ctrl + V ile de yapıştırabilirsin" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Grid><TextBox x:Name="UrlBox" AutomationProperties.Name="Video bağlantısı" Height="46" VerticalContentAlignment="Center" KeyDown="UrlKeyDown" TextChanged="UrlChanged"/><TextBlock x:Name="UrlPlaceholder" Text="https://youtube.com/watch?v=…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0" FontSize="12"/></Grid>
         <Button x:Name="PasteButton" Grid.Column="1" Content="Yapıştır" Margin="9,0" Click="Paste" Padding="15,10"/>
         <Button x:Name="AnalyzeButton" Grid.Column="2" Content="Bağlantıyı incele  →" Style="{StaticResource Primary}" Click="Analyze" Padding="17,10"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,13,0,0"><TextBlock Text="YouTube" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="  ·  Instagram  ·  X  ·  TikTok  ·  diğer platformlar" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
       </StackPanel>
      </Border>
      <Border x:Name="FailureCard" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,18" Visibility="Collapsed" BorderBrush="{DynamicResource Danger}">
       <StackPanel>
        <TextBlock x:Name="FailureTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
        <TextBlock x:Name="FailureMessage" TextWrapping="Wrap" FontSize="12" LineHeight="21" Margin="0,9,0,13"/>
        <WrapPanel><Button Content="Videoyu tarayıcıda aç  ↗" Click="OpenVideoInBrowser" FontSize="11" Padding="12,9" Margin="0,0,9,8"/><Button Content="Oturum ayarları" Click="ConfigureSession" FontSize="11" Padding="12,9" Margin="0,0,9,8"/><Button Content="Yardım" Click="OpenYouTubeHelp" FontSize="11" Padding="12,9" Margin="0,0,0,8"/></WrapPanel>
        <Expander x:Name="FailureDetailsExpander" Header="Teknik ayrıntılar" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"><TextBox x:Name="FailureDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" FontSize="10" Margin="0,9,0,0"/></Expander>
       </StackPanel>
      </Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource GlassCard}" Padding="19">
        <StackPanel>
         <DockPanel Margin="0,0,0,14"><TextBlock Text="ÖNİZLEME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="PlatformLabel" Text="BAĞLANTI BEKLENİYOR" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel>
         <Border CornerRadius="14" Background="{DynamicResource TraySurface}" Height="186" ClipToBounds="True">
          <Grid><Image x:Name="ThumbnailImage" Stretch="UniformToFill" Visibility="Collapsed"/>
           <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="42" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Sıradaki favorin burada." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,17,0,0"/></StackPanel>
           <Border Background="#CC172031" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4" CornerRadius="5" x:Name="DurationBadge" Visibility="Collapsed"><TextBlock x:Name="DurationText" Foreground="White" FontSize="10"/></Border>
          </Grid>
         </Border>
         <TextBlock x:Name="VideoTitle" Text="Önce bir bağlantı ekle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="67" TextTrimming="CharacterEllipsis" Margin="0,16,0,7"/>
         <TextBlock x:Name="VideoAuthor" Text="Video bilgileri ve kullanılabilir kaliteler burada görünecek." Style="{StaticResource Hint}"/>
         <WrapPanel x:Name="VideoBadges" Margin="0,13,0,0"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20">
        <StackPanel>
         <TextBlock Text="SANA UYGUN BİÇİM" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="VideoModeButton" Click="ChooseVideo" Padding="10,12"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Margin="0,2,8,0"/><TextBlock Text="MP4 video" FontSize="12"/></StackPanel></Button>
          <Button x:Name="AudioModeButton" Grid.Column="2" Click="ChooseAudio" Padding="10,12"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Margin="0,2,8,0"/><TextBlock Text="MP3 ses" FontSize="12"/></StackPanel></Button>
         </Grid>
         <TextBlock x:Name="QualityHeading" Text="ÇÖZÜNÜRLÜK" Style="{StaticResource Label}" Margin="0,21,0,8"/>
         <ComboBox x:Name="QualityBox" IsEnabled="False" MinHeight="43" AutomationProperties.Name="Video çözünürlüğü"/>
         <ComboBox x:Name="AudioQualityBox" Visibility="Collapsed" MinHeight="43" SelectionChanged="AudioQualityChanged" AutomationProperties.Name="Ses kalitesi"><ComboBoxItem Content="320 kbps · En yüksek" Tag="320"/><ComboBoxItem Content="256 kbps · Yüksek" Tag="256"/><ComboBoxItem Content="192 kbps · Dengeli" Tag="192"/><ComboBoxItem Content="128 kbps · Küçük dosya" Tag="128"/></ComboBox>
         <TextBlock x:Name="QualityHint" Text="Kaliteler kaynak videoya göre listelenir." Style="{StaticResource Hint}" FontSize="10" Margin="0,7,0,0"/>
         <TextBlock Text="KAYIT KONUMU" Style="{StaticResource Label}" Margin="0,17,0,8"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FolderLabel" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="FolderButton" Grid.Column="1" Content="Değiştir" FontSize="10" Padding="10,7" Click="SelectFolder"/></Grid>
         <Button x:Name="DownloadButton" Content="↓   İndirmeyi başlat" Style="{StaticResource Primary}" Click="StartDownload" IsEnabled="False" Margin="0,19,0,0" Padding="16,13"/>
        </StackPanel>
       </Border>
      </Grid>
      <Border x:Name="TransferCard" Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,17,0,0" Visibility="Collapsed">
       <StackPanel><DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="İptal et" FontSize="11" Padding="12,7" Click="CancelOperation"/><StackPanel><TextBlock x:Name="TransferTitle" Text="Hazırlanıyor…" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="TransferDetail" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel><ProgressBar x:Name="TransferBar" Margin="0,12,0,0" Maximum="100"/><Button x:Name="ResultButton" Content="İndirilen dosyayı göster  ↗" HorizontalAlignment="Left" Margin="0,12,0,0" FontSize="11" Padding="10,7" Click="ShowLastResult" Visibility="Collapsed"/></StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
      <DockPanel Margin="0,0,0,24">
       <Button x:Name="RefreshHistoryButton" DockPanel.Dock="Right" Click="RefreshHistoryClicked" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Dosyaları kontrol et ve silinenleri listeden kaldır"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,2,9,0"/><TextBlock Text="Yenile"/></StackPanel></Button>
       <StackPanel><TextBlock Text="Arşivin, elinin altında." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Dosyalarını sildiğinde listeyi yenileyerek güncelleyebilirsin." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,9,0,0"/></StackPanel>
      </DockPanel>
      <Border x:Name="EmptyHistory" Style="{StaticResource GlassCard}" Padding="32"><StackPanel><TextBlock Text="Görüntülenecek indirme yok." FontSize="19"/><TextBlock Text="Yeni indirmelerin burada görünecek." Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel></Border>
      <ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="{Binding FilePath}" ToolTip="{Binding FilePath}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Aç" Click="OpenHistoryFile" Tag="{Binding}" FontSize="11" Padding="12,8" Margin="0,0,7,0"/><Button Content="Klasör" Click="RevealHistoryFile" Tag="{Binding}" FontSize="11" Padding="12,8"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel x:Name="ThemesPage" Visibility="Collapsed">
      <TextBlock Text="Biraz da senin rengin." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Pad Studio'dan tanıdığın dört görünüm. Seçimin otomatik kaydedilir." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,9,0,26"/>
      <UniformGrid x:Name="ThemeCards" Columns="2"/>
      <Border Style="{StaticResource GlassCard}" Padding="22" Margin="8,14,8,0"><StackPanel><TextBlock x:Name="ActiveThemeLabel" FontWeight="SemiBold"/><TextBlock Text="Tema; arka planı, kartları, açılır listeleri ve pencere renklerini birlikte değiştirir." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <TextBlock Text="Her şey yerli yerinde." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="İndirme motoru, kayıt konumu ve isteğe bağlı oturum dosyan." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,9,0,24"/>
      <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="İndirme motoru" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ToolVersions" Style="{StaticResource Hint}" Margin="0,10,0,16"/><Button x:Name="UpdateButton" Content="Motoru güncelle" Click="UpdateEngine" HorizontalAlignment="Left"/><TextBlock Text="Resmi yt-dlp nightly sürümü indirilir ve SHA256 ile doğrulanır." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="Platform oturumu" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="YouTube 429 veya bot doğrulaması gösterirse önce videoyu kendi tarayıcında aç ve varsa doğrulamayı tamamla. Gerekirse kendi YouTube oturumuna ait güncel Netscape biçimli cookies.txt dosyanı seç. Dosya seçmek erişimin açılacağını garanti etmez." Style="{StaticResource Hint}" Margin="0,10,0,13"/><TextBlock x:Name="CookieLabel" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,13"/><WrapPanel><Button x:Name="CookieButton" Content="cookies.txt seç" Click="SelectCookies" Margin="0,0,9,8"/><Button x:Name="RemoveCookieButton" Content="Kaldır" Click="RemoveCookies" Margin="0,0,9,8"/><Button Content="YouTube yardımını aç  ↗" Click="OpenYouTubeHelp" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource GlassCard}" Padding="24"><StackPanel><TextBlock Text="Ayarlar ve geçmiş" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DataLocationLabel" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="Video Studio · Sürüm 1.1.1 · Windows x64" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,5,8,0"><DockPanel><TextBlock x:Name="FooterStatus" Text="Hazır. Bir video bağlantısıyla başlayabilirsin." FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="MP4  /  MP3" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
